<Window x:Class="lads0.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MainWindow" Height="550" Width="950">
    <Grid>
        <Canvas x:Name="Scene" 
                HorizontalAlignment="Left" 
                Height="400" 
                Margin="15,30,0,0" 
                VerticalAlignment="Top" 
                Width="680" 
                Background="White"/>

        <StackPanel Margin="710,30,0,0" HorizontalAlignment="Left" VerticalAlignment="Top">
            <Label Content="Случайные фигуры" FontWeight="Bold"/>
            <Button Content="Случайный треугольник" Width="150" Margin="0,5" Click="RandomTriangle_Click"/>
            <Button Content="Случайный прямоугольник" Width="150" Margin="0,5" Click="RandomRectangle_Click"/>
            <Button Content="Случайный квадрат" Width="150" Margin="0,5" Click="RandomSquare_Click"/>

            <Label Content="Задать параметры" FontWeight="Bold" Margin="0,15,0,0"/>
            <Grid Margin="0,5,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="60"/>
                    <ColumnDefinition Width="85"/>
                </Grid.ColumnDefinitions>
                <Label Content="X:" Grid.Column="0"/>
                <TextBox x:Name="InputX" Grid.Column="1" Text="100" Width="80"/>
            </Grid>
            <Grid Margin="0,5,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="60"/>
                    <ColumnDefinition Width="85"/>
                </Grid.ColumnDefinitions>
                <Label Content="Y:" Grid.Column="0"/>
                <TextBox x:Name="InputY" Grid.Column="1" Text="100" Width="80"/>
            </Grid>
            <Grid Margin="0,5,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="60"/>
                    <ColumnDefinition Width="85"/>
                </Grid.ColumnDefinitions>
                <Label Content="Размер:" Grid.Column="0"/>
                <TextBox x:Name="InputSize" Grid.Column="1" Text="80" Width="80"/>
            </Grid>
            <Button Content="Нарисовать квадрат" Width="150" Margin="0,10" Click="DrawSquare_Click"/>
            <Button Content="Нарисовать треугольник" Width="150" Margin="0,5" Click="DrawTriangle_Click"/>

            <Label Content="Перемещение" FontWeight="Bold" Margin="0,15,0,0"/>
            <Label Content="Сдвиг по X" Margin="0,5,0,0"/>
            <Slider x:Name="SliderX" Width="150" Minimum="-100" Maximum="100" Value="0"/>
            <Label Content="Сдвиг по Y" Margin="0,5,0,0"/>
            <Slider x:Name="SliderY" Width="150" Minimum="-100" Maximum="100" Value="0"/>
            <Button Content="Переместить" Width="150" Margin="0,10" Click="MoveShape_Click"/>
            <Button Content="Очистить сцену" Width="150" Margin="0,5" Click="ClearScene_Click"/>
        </StackPanel>
    </Grid>
</Window>